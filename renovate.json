{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "* 5 * * 4"
  ],
  "updateNotScheduled": true,
  "enabledManagers": [
    "custom.regex"
  ],
  "ignorePaths": [],
  "description": "scheduled and manual workflow runs bypass the repository schedule for reliable discovery, while push runs remain limited to the Thursday 5 AM Eastern new-branch window and updateNotScheduled keeps their existing-branch rebases active. automerge deliberately covers every managed update, majors included; only conflicts and red required checks block a merge. automergeStrategy is pinned because its derived default follows repository merge settings. rebaseWhen and platformAutomerge stay at defaults: with automerge on, rebaseWhen=auto resolves to behind-base-branch (verified against Renovate 44.48.0), which the ruleset's strict status-check policy requires.",
  "automerge": true,
  "automergeStrategy": "squash",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^custom_components/esphome_mcp/_vendor/requirements\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[A-Za-z0-9.!+-]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=home-assistant/operating-system\\s+HAOS_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)[\"']"
      ],
      "depNameTemplate": "home-assistant/operating-system",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/pr\\.yml$/",
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "renovate-version:\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/",
        "/^hacs\\.json$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=home-assistant/core\\s+HA_CORE_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']",
        "\"homeassistant\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Home Assistant `(?<currentValue>\\d+\\.\\d+\\.\\d+)` or newer\\."
      ],
      "depNameTemplate": "home-assistant/core",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=homeassistant-ai/ha-mcp-integration\\s+HA_MCP_INTEGRATION_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']"
      ],
      "depNameTemplate": "homeassistant-ai/ha-mcp-integration",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Vendored FastMCP / MCP SDK, re-synced and released together",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "fastmcp-slim",
        "mcp",
        "mcp-types"
      ],
      "groupName": "vendored FastMCP runtime",
      "labels": [
        "dependencies",
        "python",
        "e2e"
      ],
      "prBodyNotes": [
        "## Release notes\n\n- Updated ESPHome MCP's bundled FastMCP / MCP SDK runtime."
      ],
      "postUpgradeTasks": {
        "commands": [
          "python scripts/vendor_fastmcp.py",
          "python scripts/bump_component_version.py origin/master"
        ],
        "fileFilters": [
          "custom_components/esphome_mcp/**",
          "pyproject.toml"
        ],
        "executionMode": "branch",
        "installTools": {
          "python": {}
        }
      }
    },
    {
      "description": "Home Assistant OS image version used by HAOS E2E",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "home-assistant/operating-system"
      ],
      "labels": [
        "dependencies",
        "haos",
        "e2e"
      ]
    },
    {
      "description": "Home Assistant Core version tested and required by ESPHome MCP",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "home-assistant/core"
      ],
      "labels": [
        "dependencies",
        "home-assistant",
        "e2e"
      ]
    },
    {
      "description": "HA-MCP release baked into the HAOS E2E image as a coexistence peer (test-only)",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "homeassistant-ai/ha-mcp-integration"
      ],
      "labels": [
        "dependencies",
        "e2e"
      ]
    }
  ],
  "labels": [
    "dependencies"
  ]
}
