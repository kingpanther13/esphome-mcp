{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "UTC",
  "enabledManagers": [
    "custom.regex"
  ],
  "ignorePaths": [],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/fastmcp_canary\\.txt$/"
      ],
      "matchStrings": [
        "# renovate: datasource=pypi depName=fastmcp\\s+fastmcp==(?<currentValue>\\d+\\.\\d+\\.\\d+(?:(?:a|b|rc)\\d+)?)"
      ],
      "depNameTemplate": "fastmcp",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=home-assistant/operating-system\\s+HAOS_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)[\"']"
      ],
      "depNameTemplate": "home-assistant/operating-system",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/",
        "/^hacs\\.json$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=home-assistant/core\\s+HA_CORE_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']",
        "\"homeassistant\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Home Assistant `(?<currentValue>\\d+\\.\\d+\\.\\d+)` or newer\\."
      ],
      "depNameTemplate": "home-assistant/core",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "FastMCP standalone release canary",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "fastmcp"
      ],
      "labels": [
        "dependencies",
        "python",
        "compatibility",
        "e2e"
      ]
    },
    {
      "description": "Home Assistant OS image version used by HAOS E2E",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "home-assistant/operating-system"
      ],
      "labels": [
        "dependencies",
        "haos",
        "e2e"
      ]
    },
    {
      "description": "Home Assistant Core version tested and required by ESPHome MCP",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "home-assistant/core"
      ],
      "labels": [
        "dependencies",
        "home-assistant",
        "e2e"
      ]
    }
  ],
  "labels": [
    "dependencies"
  ]
}
