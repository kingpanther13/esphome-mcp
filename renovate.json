{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "UTC",
  "enabledManagers": [
    "custom.regex"
  ],
  "ignorePaths": [],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^custom_components/esphome_mcp/ha_mcp_runtime/contract\\.py$/"
      ],
      "matchStrings": [
        "HA_MCP_MASTER_SHA\\s*=\\s*[\"'](?<currentDigest>[0-9a-f]{40})[\"']"
      ],
      "currentValueTemplate": "master",
      "depNameTemplate": "HA-MCP master runtime contract",
      "packageNameTemplate": "https://github.com/homeassistant-ai/ha-mcp",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=home-assistant/operating-system\\s+HAOS_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)[\"']"
      ],
      "depNameTemplate": "home-assistant/operating-system",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/pr\\.yml$/",
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "renovate-version:\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']"
      ],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/haos_image_build/build_image\\.py$/",
        "/^hacs\\.json$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=home-assistant/core\\s+HA_CORE_VERSION\\s*=\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']",
        "\"homeassistant\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "Home Assistant `(?<currentValue>\\d+\\.\\d+\\.\\d+)` or newer\\."
      ],
      "depNameTemplate": "home-assistant/core",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "HA-MCP master server and custom-component lockstep",
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/homeassistant-ai/ha-mcp"
      ],
      "labels": [
        "dependencies",
        "python",
        "ha-mcp",
        "e2e"
      ],
      "prBodyNotes": [
        "## Release notes\n\n- Updated ESPHome MCP's embedded runtime contract to the latest HA-MCP `master` snapshot."
      ],
      "postUpgradeTasks": {
        "commands": [
          "python scripts/sync_ha_mcp_runtime_contract.py --contract-ref",
          "python scripts/bump_component_version.py origin/master"
        ],
        "fileFilters": [
          "custom_components/esphome_mcp/ha_mcp_runtime/contract.py",
          "custom_components/esphome_mcp/manifest.json",
          "custom_components/esphome_mcp/const.py",
          "pyproject.toml"
        ],
        "executionMode": "update",
        "installTools": {
          "python": {}
        }
      }
    },
    {
      "description": "Home Assistant OS image version used by HAOS E2E",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "home-assistant/operating-system"
      ],
      "labels": [
        "dependencies",
        "haos",
        "e2e"
      ]
    },
    {
      "description": "Home Assistant Core version tested and required by ESPHome MCP",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "home-assistant/core"
      ],
      "labels": [
        "dependencies",
        "home-assistant",
        "e2e"
      ]
    }
  ],
  "labels": [
    "dependencies"
  ]
}
